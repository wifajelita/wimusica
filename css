*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Poppins,sans-serif;
}

html{
scroll-behavior:smooth;
}

body{

background:
linear-gradient(135deg,#4b1d80,#8b5cf6,#d946ef);

color:white;

overflow-x:hidden;

}

header{

display:flex;

justify-content:space-between;

align-items:center;

padding:25px 10%;

position:fixed;

width:100%;

backdrop-filter:blur(18px);

background:rgba(255,255,255,.08);

z-index:999;

}

.logo{

font-size:28px;

font-weight:700;

}

nav a{

text-decoration:none;

color:white;

margin-left:35px;

transition:.3s;

}

nav a:hover{

color:#ffd6ff;

}

.hero{

min-height:100vh;

display:flex;

justify-content:space-between;

align-items:center;

padding:0 10%;

}

.hero-left{

width:50%;

}

.hero-left h1{

font-size:72px;

line-height:1.1;

margin-bottom:25px;

}

.hero-left p{

font-size:20px;

opacity:.9;

margin-bottom:40px;

}

.buttons{

display:flex;

gap:20px;

}

.btn{

background:#ff4fd8;

padding:15px 35px;

border-radius:50px;

text-decoration:none;

color:white;

font-weight:600;

transition:.3s;

}

.btn:hover{

transform:translateY(-4px);

box-shadow:0 10px 30px rgba(255,0,255,.4);

}

.btn-outline{

border:2px solid white;

padding:15px 35px;

border-radius:50px;

text-decoration:none;

color:white;

transition:.3s;

}

.btn-outline:hover{

background:white;

color:#7b2cbf;

}

.hero-right{

display:flex;

justify-content:center;

align-items:center;

width:40%;

}

.music-card{

width:330px;

padding:30px;

border-radius:30px;

background:rgba(255,255,255,.12);

backdrop-filter:blur(25px);

box-shadow:0 25px 60px rgba(0,0,0,.3);

text-align:center;

}

.cover{

width:250px;

height:250px;

margin:auto;

border-radius:20px;

background:

linear-gradient(135deg,#ff4fd8,#8b5cf6);

margin-bottom:25px;

}

.wave{

display:flex;

justify-content:center;

align-items:flex-end;

height:60px;

margin-top:25px;

gap:8px;

}

.wave span{

width:8px;

background:blue;

animation:wave 1s infinite ease-in-out;

border-radius:10px;

}

.wave span:nth-child(1){height:20px;}
.wave span:nth-child(2){height:40px;}
.wave span:nth-child(3){height:60px;}
.wave span:nth-child(4){height:40px;}
.wave span:nth-child(5){height:20px;}

@keyframes wave{

50%{

transform:scaleY(.4);

}

}

section{

padding:120px 10%;

}

.about{

text-align:center;

max-width:900px;

margin:auto;

}

.about h2{

font-size:42px;

margin-bottom:20px;

}

.features{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:35px;

}

.feature{

padding:40px;

border-radius:20px;

background:rgba(255,255,255,.08);

backdrop-filter:blur(15px);

transition:.3s;

}

.feature:hover{

transform:translateY(-8px);

}

.stats{

display:flex;

justify-content:space-around;

text-align:center;

}

.stats h2{

font-size:60px;

}

.cta{

text-align:center;

}

.cta h2{

font-size:45px;

margin-bottom:30px;

}

footer{

text-align:center;

padding:35px;

background:rgba(255,255,255,.08);

}

.reveal{

opacity:0;

transform:translateY(80px);

transition:1s;

}

.reveal.active{

opacity:1;

transform:translateY(0);

}

@media(max-width:900px){

.hero{

flex-direction:column;

text-align:center;

padding-top:140px;

}

.hero-left,.hero-right{

width:100%;

}

.hero-left h1{

font-size:50px;

}

.features{

grid-template-columns:1fr;

}

.stats{

flex-direction:column;

gap:40px;

}

nav{

display:none;

}

}
