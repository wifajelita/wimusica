* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --lavender: #c7b8ff;
  --blue: #8da9ff;
  --purple: #7457e8;

  --deep: #17142d;
  --deep-2: #0d0b1d;

  --text: #f7f5ff;
  --muted: #a7a3b9;

  --border: rgba(255,255,255,.1);
  --glass: rgba(255,255,255,.055);
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "DM Sans", sans-serif;
  background: var(--deep-2);
  color: var(--text);
  overflow-x: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.bg-orb {
  position: fixed;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  filter: blur(100px);
  opacity: .15;
  pointer-events: none;
  z-index: -1;
}

.orb-one {
  background: #795cff;
  top: -180px;
  left: -100px;
}

.orb-two {
  background: #5d9bff;
  right: -180px;
  top: 45%;
}


/* =========================
   NAVBAR
========================= */

.navbar {
  width: min(1180px, calc(100% - 48px));
  height: 82px;
  margin: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;

  position: relative;
  z-index: 10;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;

  font-family: "Outfit", sans-serif;
  font-weight: 800;
  font-size: 20px;
}

.logo > span:last-child span {
  color: var(--lavender);
}

.logo-mark {
  display: grid;
  place-items: center;

  width: 34px;
  height: 34px;

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      var(--lavender),
      var(--purple)
    );

  box-shadow:
    0 7px 25px rgba(116,87,232,.35);
}

.nav-links {
  display: flex;
  gap: 36px;

  color: var(--muted);
  font-size: 14px;
}

.nav-links a {
  transition: .25s;
}

.nav-links a:hover {
  color: white;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.search-btn,
.menu-btn {
  border: 0;
  color: var(--muted);
  background: transparent;
  cursor: pointer;
}

.search-btn {
  font-size: 25px;
  transform: rotate(-20deg);
}

.login-btn {
  border: 1px solid var(--border);
  background: var(--glass);
  color: white;

  border-radius: 100px;

  padding: 10px 18px;

  cursor: pointer;
}

.menu-btn {
  display: none;
  flex-direction: column;
  gap: 4px;
}

.menu-btn span {
  width: 22px;
  height: 2px;
  background: white;
}


/* =========================
   HERO
========================= */

.hero {
  width: min(1180px, calc(100% - 48px));

  min-height: 680px;

  margin: auto;

  display: grid;
  grid-template-columns: 1.05fr .95fr;

  align-items: center;

  gap: 40px;

  padding: 60px 0 100px;
}

.eyebrow,
.section-kicker {
  color: var(--lavender);

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 2.2px;
}

.eyebrow {
  display: flex;
  align-items: center;

  gap: 9px;

  margin-bottom: 22px;
}

.pulse {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #9f8cff;

  box-shadow:
    0 0 0 5px rgba(159,140,255,.12);

  animation: pulse 1.8s infinite;
}

@keyframes pulse {

  50% {
    box-shadow:
      0 0 0 9px rgba(159,140,255,0);
  }

}

h1,
h2 {
  font-family: "Outfit", sans-serif;

  letter-spacing: -2.5px;
}

h1 {
  font-size: clamp(55px, 7vw, 86px);

  line-height: .98;

  font-weight: 700;
}

h1 span,
.genre-copy h2 span {

  background:
    linear-gradient(
      100deg,
      #d9d0ff,
      #91baff 55%,
      #a98cff
    );

  -webkit-background-clip: text;

  color: transparent;
}

.hero-text {

  color: var(--muted);

  max-width: 520px;

  line-height: 1.75;

  font-size: 16px;

  margin: 28px 0;
}

.hero-actions {

  display: flex;

  align-items: center;

  gap: 14px;
}

.primary-btn,
.secondary-btn {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 17px;

  border-radius: 100px;

  font-weight: 600;

  font-size: 14px;

  transition: .25s;
}

.primary-btn {

  padding: 14px 21px;

  background:
    linear-gradient(
      110deg,
      #bdb0ff,
      #7658e9
    );

  color: #16122d;

  box-shadow:
    0 12px 35px rgba(116,87,232,.27);
}

.primary-btn:hover {

  transform: translateY(-3px);

  box-shadow:
    0 18px 40px rgba(116,87,232,.38);
}

.secondary-btn {

  padding: 13px 19px;

  border: 1px solid var(--border);

  color: #d6d3e2;
}

.secondary-btn:hover {

  background: var(--glass);
}

.hero-stats {

  display: flex;

  align-items: center;

  gap: 19px;

  margin-top: 54px;
}

.hero-stats strong {

  display: block;

  font-family: "Outfit";

  font-size: 20px;
}

.hero-stats span {

  display: block;

  color: var(--muted);

  font-size: 11px;

  margin-top: 3px;
}

.stat-line {

  width: 1px;

  height: 27px;

  background: var(--border);
}


/* =========================
   VINYL
========================= */

.hero-visual {

  height: 520px;

  position: relative;

  display: grid;

  place-items: center;
}

.visual-glow {

  position: absolute;

  width: 320px;
  height: 320px;

  background:
    linear-gradient(
      135deg,
      #8669ff,
      #638dff
    );

  border-radius: 50%;

  filter: blur(80px);

  opacity: .18;
}

.vinyl-card {

  position: relative;

  width: 370px;
  height: 370px;

  display: flex;

  align-items: center;
  justify-content: center;

  transform: rotate(-5deg);

  animation: float 6s ease-in-out infinite;
}

@keyframes float {

  50% {
    transform:
      translateY(-12px)
      rotate(-2deg);
  }

}

.album-art {

  position: absolute;

  width: 270px;
  height: 270px;

  border-radius: 19px;

  overflow: hidden;

  left: 15px;
  top: 49px;

  background:
    linear-gradient(
      155deg,
      #bcaaff 5%,
      #5c77d9 50%,
      #202047
    );

  box-shadow:
    0 35px 65px rgba(0,0,0,.45);
}

.album-sun {

  position: absolute;

  width: 100px;
  height: 100px;

  border-radius: 50%;

  top: 32px;
  right: 34px;

  background:
    linear-gradient(
      135deg,
      #fff0bd,
      #c4b3ff
    );
}

.album-mountain {

  position: absolute;

  bottom: -25px;

  width: 0;
  height: 0;

  border-left: 140px solid transparent;
  border-right: 140px solid transparent;

  border-bottom: 220px solid #262454;
}

.mountain-back {

  left: -45px;

  opacity: .55;

  border-bottom-color: #4d56a0;
}

.mountain-front {

  right: -65px;

  border-bottom-color: #171633;
}

.album-label {

  position: absolute;

  left: 23px;
  bottom: 20px;

  font-family: "Outfit";

  font-size: 45px;

  font-weight: 800;

  color: rgba(255,255,255,.65);
}

.vinyl {

  position: absolute;

  width: 250px;
  height: 250px;

  border-radius: 50%;

  right: -10px;
  top: 58px;

  background:
    repeating-radial-gradient(
      circle,
      #111 0 2px,
      #181818 3px 4px
    );

  box-shadow:
    18px 20px 35px rgba(0,0,0,.5);
}

.vinyl::after {

  content: "";

  position: absolute;

  inset: 30px;

  border-radius: 50%;

  border:
    1px solid rgba(255,255,255,.05);
}

.vinyl-center {

  position: absolute;

  width: 45px;
  height: 45px;

  border-radius: 50%;

  top: calc(50% - 22px);
  left: calc(50% - 22px);

  background:
    linear-gradient(
      135deg,
      #a99aff,
      #6852db
    );

  border: 5px solid #16151d;
}


/* =========================
   FLOATING CARD
========================= */

.floating-card {

  position: absolute;

  border:
    1px solid rgba(255,255,255,.11);

  background:
    rgba(28,25,51,.72);

  backdrop-filter: blur(20px);

  box-shadow:
    0 18px 45px rgba(0,0,0,.28);
}

.now-playing {

  bottom: 30px;
  left: 0;

  display: flex;

  align-items: center;

  gap: 12px;

  width: 285px;

  padding: 12px;

  border-radius: 16px;
}

.mini-cover {

  width: 43px;
  height: 43px;

  border-radius: 10px;

  background:
    linear-gradient(
      135deg,
      #c2b5ff,
      #5d77e5
    );
}

.track-info {

  min-width: 0;

  flex: 1;
}

.track-info span,
.track-info small {

  display: block;

  color: #9691aa;

  font-size: 8px;

  letter-spacing: 1px;
}

.track-info strong {

  display: block;

  font-size: 12px;

  margin: 4px 0;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.play-small {

  width: 31px;
  height: 31px;

  border: 0;

  border-radius: 50%;

  background: white;

  color: #16132d;

  cursor: pointer;
}

.music-note {

  width: 42px;
  height: 42px;

  border-radius: 13px;

  display: grid;

  place-items: center;

  color: #c9c0ff;

  font-size: 20px;
}

.note-one {

  top: 75px;
  right: 25px;

  transform: rotate(12deg);
}

.note-two {

  bottom: 110px;
  right: 20px;

  transform: rotate(-10deg);

  color: #8eb7ff;
}


/* =========================
   SECTIONS
========================= */

.section,
.artist-section {

  width: min(1180px, calc(100% - 48px));

  margin: auto;

  padding: 90px 0;
}

.section-heading {

  display: flex;

  align-items: end;

  justify-content: space-between;

  margin-bottom: 32px;
}

h2 {

  font-size: clamp(34px, 4vw, 48px);

  line-height: 1.05;

  margin-top: 10px;
}

.view-all,
.text-link {

  color: #c5baff;

  font-size: 13px;

  font-weight: 600;
}


/* =========================
   MUSIC CARDS
========================= */

.music-grid {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 18px;
}

.music-card {

  min-width: 0;

  transition: .3s;
}

.music-card:hover {

  transform: translateY(-5px);
}

.card-cover {

  height: 230px;

  border-radius: 18px;

  position: relative;

  overflow: hidden;

  display: grid;

  place-items: center;
}

.cover-one {

  background:
    linear-gradient(
      145deg,
      #b69fff,
      #6e52d5 60%,
      #30216d
    );
}

.cover-two {

  background:
    linear-gradient(
      145deg,
      #9cbcff,
      #5374dc 60%,
      #28356f
    );
}

.cover-three {

  background:
    linear-gradient(
      145deg,
      #514b86,
      #24224c 60%,
      #111022
    );
}

.cover-four {

  background:
    linear-gradient(
      145deg,
      #e2d8ff,
      #a891ed 55%,
      #6651bd
    );
}

.card-cover::before {

  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  border-radius: 50%;

  border:
    1px solid rgba(255,255,255,.25);

  box-shadow:
    0 0 0 35px rgba(255,255,255,.03),
    0 0 0 70px rgba(255,255,255,.025);
}

.cover-symbol {

  position: relative;

  font-family: "Outfit";

  font-size: 64px;

  color: rgba(255,255,255,.7);
}

.card-play {

  position: absolute;

  right: 14px;
  bottom: 14px;

  width: 43px;
  height: 43px;

  border: 0;

  border-radius: 50%;

  background: white;

  color: #16132d;

  cursor: pointer;

  opacity: 0;

  transition: .25s;
}

.music-card:hover .card-play {

  opacity: 1;
}

.card-info {

  padding: 15px 3px;
}

.card-info h3 {

  font-size: 15px;

  font-weight: 600;
}

.card-info p {

  margin-top: 5px;

  color: var(--muted);

  font-size: 11px;
}


/* =========================
   GENRES
========================= */

.genres-section {

  width: min(1180px, calc(100% - 48px));

  margin: 50px auto;

  padding: 80px 75px;

  border:
    1px solid var(--border);

  border-radius: 30px;

  background:
    radial-gradient(
      circle at 80% 15%,
      rgba(126,101,244,.2),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      rgba(255,255,255,.055),
      rgba(255,255,255,.015)
    );

  display: grid;

  grid-template-columns: .8fr 1.2fr;

  gap: 70px;

  align-items: center;
}

.genre-copy p {

  color: var(--muted);

  line-height: 1.7;

  font-size: 14px;

  max-width: 410px;

  margin: 22px 0;
}

.genre-cloud {

  display: flex;

  flex-wrap: wrap;

  justify-content: center;

  gap: 12px;
}

.genre-pill {

  border:
    1px solid rgba(255,255,255,.12);

  color: #d9d6e6;

  background:
    rgba(255,255,255,.045);

  padding: 13px 22px;

  border-radius: 100px;

  cursor: pointer;

  transition: .25s;
}

.genre-pill:hover,
.genre-pill.pill-accent {

  background:
    linear-gradient(
      120deg,
      rgba(196,181,255,.23),
      rgba(102,139,255,.18)
    );

  border-color:
    rgba(194,181,255,.35);

  color: white;

  transform: translateY(-3px);
}

.genre-pill.pill-large {

  padding: 17px 27px;

  font-size: 17px;
}


/* =========================
   ARTISTS
========================= */

.artist-row {

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  gap: 18px;
}

.artist {

  padding: 25px 15px;

  border:
    1px solid var(--border);

  border-radius: 20px;

  text-align: center;

  background:
    rgba(255,255,255,.025);

  transition: .25s;
}

.artist:hover {

  background:
    rgba(255,255,255,.055);

  transform:
    translateY(-4px);
}

.artist-avatar {

  width: 92px;
  height: 92px;

  margin: auto;
  margin-bottom: 15px;

  border-radius: 50%;

  display: grid;

  place-items: center;

  font-family: "Outfit";

  font-size: 33px;

  font-weight: 700;
}

.avatar-one {

  background:
    linear-gradient(
      135deg,
      #c5b6ff,
      #7157dd
    );
}

.avatar-two {

  background:
    linear-gradient(
      135deg,
      #9ebaff,
      #5274d7
    );
}

.avatar-three {

  background:
    linear-gradient(
      135deg,
      #e0cfff,
      #8a68c9
    );
}

.avatar-four {

  background:
    linear-gradient(
      135deg,
      #7771bb,
      #302e69
    );
}

.artist strong,
.artist span {

  display: block;
}

.artist strong {

  font-size: 14px;
}

.artist span {

  color: var(--muted);

  font-size: 11px;

  margin-top: 5px;
}


/* =========================
   CTA
========================= */

.cta-section {

  width: min(980px, calc(100% - 48px));

  margin: 80px auto 120px;

  text-align: center;

  padding: 100px 30px;

  border-radius: 30px;

  position: relative;

  overflow: hidden;

  border:
    1px solid rgba(202,190,255,.15);

  background:
    radial-gradient(
      circle at 50% 10%,
      rgba(166,144,255,.2),
      transparent 35%
    ),
    #17142d;
}

.cta-glow {

  position: absolute;

  width: 260px;
  height: 260px;

  left: calc(50% - 130px);

  bottom: -180px;

  border-radius: 50%;

  background: #6f58e8;

  filter: blur(80px);

  opacity: .25;
}

.cta-section h2 {

  position: relative;

  font-size: clamp(42px, 6vw, 67px);

  margin: 12px 0 17px;
}

.cta-section p {

  position: relative;

  color: var(--muted);

  margin-bottom: 28px;
}


/* =========================
   FOOTER
========================= */

.footer {

  width: min(1180px, calc(100% - 48px));

  margin: auto;

  padding: 28px 0 40px;

  border-top:
    1px solid var(--border);

  display: flex;

  align-items: center;

  justify-content: space-between;

  color: var(--muted);

  font-size: 11px;
}

.footer-links {

  display: flex;

  gap: 22px;
}


/* =========================
   SEARCH
========================= */

.search-overlay {

  position: fixed;

  inset: 0;

  z-index: 100;

  background:
    rgba(8,7,17,.88);

  backdrop-filter: blur(20px);

  display: grid;

  place-items: center;

  opacity: 0;

  pointer-events: none;

  transition: .25s;
}

.search-overlay.active {

  opacity: 1;

  pointer-events: auto;
}

.search-box {

  width: min(650px, calc(100% - 40px));

  border-bottom:
    1px solid rgba(255,255,255,.25);

  display: flex;

  align-items: center;

  gap: 15px;

  padding: 18px 5px;
}

.search-box input {

  width: 100%;

  border: 0;

  outline: 0;

  background: transparent;

  color: white;

  font-size: 22px;

  font-family: inherit;
}

.close-search {

  position: absolute;

  top: 35px;
  right: 40px;

  border: 0;

  background: transparent;

  color: white;

  font-size: 35px;

  cursor: pointer;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {

  .hero {

    grid-template-columns: 1fr;

    padding-top: 70px;
  }

  .hero-content {

    text-align: center;
  }

  .eyebrow,
  .hero-actions,
  .hero-stats {

    justify-content: center;
  }

  .hero-text {

    margin-left: auto;
    margin-right: auto;
  }

  .music-grid {

    grid-template-columns:
      repeat(2, 1fr);
  }

  .genres-section {

    grid-template-columns: 1fr;

    padding: 55px 35px;
  }

}


@media (max-width: 650px) {

  .navbar,
  .hero,
  .section,
  .artist-section,
  .footer {

    width:
      calc(100% - 30px);
  }

  .nav-links {

    display: none;

    position: absolute;

    top: 70px;

    left: 0;
    right: 0;

    padding: 20px;

    border:
      1px solid var(--border);

    border-radius: 18px;

    background:
      rgba(20,18,39,.95);

    flex-direction: column;

    gap: 20px;
  }

  .nav-links.open {

    display: flex;
  }

  .menu-btn {

    display: flex;
  }

  .login-btn {

    display: none;
  }

  h1 {

    font-size: 51px;
  }

  .hero-actions {

    flex-direction: column;
  }

  .hero-actions a {

    width: 100%;
  }

  .vinyl-card {

    transform: scale(.85);
  }

  .music-grid {

    grid-template-columns:
      1fr 1fr;

    gap: 12px;
  }

  .card-cover {

    height: 170px;
  }

  .card-play {

    opacity: 1;
  }

  .artist-row {

    grid-template-columns:
      1fr 1fr;
  }

  .genres-section {

    width: calc(100% - 30px);

    padding: 45px 25px;
  }

  .footer {

    flex-direction: column;

    gap: 20px;

    text-align: center;
  }

}
